rules_version = '2';
// Version: 1.1 - Fixing comments permissions
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Fields: name (string), price (number), attributes (map), etc.
    //
    // Collection: stock
    // Fields: productId (string), quantity (number), variation (map)
    //
    // Collection: sales
    // Fields: customerId (string), totalAmount (number), status (string), type (string)
    //
    // Collection: customers
    // Fields: name (string), totalDebt (number)
    //
    // Collection: debts
    // Fields: customerId (string), amount (number), status (string)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "pascoalbernabe678@gmail.com" ||
        request.auth.token.email == "pdacomercial64@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0;
    }

    // Rules
    
    match /comments/{commentId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']) &&
        (
          (!('ratingCount' in resource.data) && request.resource.data.ratingCount == 1) ||
          (request.resource.data.ratingCount == resource.data.ratingCount + 1)
        )
      );
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /stock/{stockId} {
      allow read: if true; // Needed for client-side availability check
      allow write: if isAdmin();
    }


    match /sales/{saleId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /debts/{debtId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statsId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitorCount']) &&
                     request.resource.data.visitorCount == resource.data.visitorCount + 1;
      allow create: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
        request.resource.data.usageCount == resource.data.usageCount + 1
      );
    }
  }
}
